<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Umbraco CMS -->
    <PackageVersion Include="Umbraco.Cms" Version="17.7.0" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="17.7.0" />
    <PackageVersion Include="Umbraco.Cms.Persistence.Sqlite" Version="17.7.0" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.7.0" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.7.0" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.7.0" />

    <!-- Umbraco Forms -->
    <PackageVersion Include="Umbraco.Forms" Version="17.5.2" />
    <PackageVersion Include="Umbraco.Forms.Core" Version="17.5.2" />

    <!-- Clean starter kit (Kevin Jump) -->
    <PackageVersion Include="Clean" Version="7.0.5" />

    <!-- Umbraco.AI (nuget.org). Anthropic 17.1.2 needs Umbraco.AI.Core >= 17.4.0 -->
    <PackageVersion Include="Umbraco.AI" Version="17.4.0" />
    <PackageVersion Include="Umbraco.AI.Persistence.Sqlite" Version="17.4.0" />
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="17.1.2" />

    <!-- Transitive pin: SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 is vulnerable (GHSA-2m69-gcr7-jv3q); comes in via CMS / Umbraco.AI EF Core Sqlite -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Globalization -->
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>
</Project>
