{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      },
      "Global": {
        "Smtp": {
          "From": "forms-guard-test@localhost",
          "DeliveryMethod": "SpecifiedPickupDirectory",
          "PickupDirectoryLocation": "umbraco/Data/mail"
        }
      }
    }
  },
  "Cogworks": {
    "FormsGuard": {
      "Enabled": true,
      "StubVerdict": "Approve",
      "Provider": "jev",
      "Jev": {
        "ApiKey": "",
        "BaseUrl": "https://api.typesafe.ai",
        "Model": "jev-1.13.0",
        "TimeoutSeconds": 10
      },
      "UmbracoAI": {
        "ProfileAlias": "spam-guard",
        "TimeoutSeconds": 30
      }
    }
  }
}
